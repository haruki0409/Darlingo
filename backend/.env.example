# Copy this file to .env and fill in your real values. Do NOT commit .env.

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

CORS_ORIGINS=["http://localhost:3000"]

# Supabase Postgres — use the SESSION POOLER connection string.
# Dashboard -> Connect -> Session pooler tab.
# (The direct "db.<ref>.supabase.co" host is IPv6-only and fails on IPv4
#  networks — always use the pooler host below.)
# Keep the "+asyncpg" driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase project — Dashboard -> Settings -> API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
