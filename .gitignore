# ============================================================
#  Darlingo — root .gitignore
# ============================================================

# ── Secrets (전체 트리에서 차단) ──
# .env, .env.local, .env.production 등 모든 변형 차단.
# 단 .env.example / .env.local.example 같은 템플릿은 허용.
.env
.env.*
!.env.example
!.env.local.example

# 명시적 backstop
AI/.env
backend/.env
frontend/.env.local

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/

# ── Node / Next.js ──
node_modules/
.next/
out/
build/
.vercel

# ── Per-user runtime data (AI 메모리 등) ──
AI/memory/*/

# ── Tools / Editor / OS ──
.serena/
.DS_Store
*.log
.idea/
.vscode/

# ── Local-only material ──
references/
.omc/
